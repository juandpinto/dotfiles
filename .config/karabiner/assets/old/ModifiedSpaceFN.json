{
    "title": "Modified SpaceFN",
    "maintainers": [
        "juandpinto"
    ],
    "rules": [{
            "description": "Modified SpaceFN: Space+[ijkl] to Up, Left, Down, Right",
            "manipulators": [{
                    "type": "basic",
                    "from": {
                        "key_code": "i",
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "to": [{
                        "key_code": "up_arrow",
                        "modifiers": []
                    }],
                    "conditions": [{
                        "type": "variable_if",
                        "name": "ergo_fly_keys_spacebar",
                        "value": 1
                    }]
                },
                {
                    "type": "basic",
                    "from": {
                        "simultaneous": [{
                                "key_code": "spacebar"
                            },
                            {
                                "key_code": "i"
                            }
                        ],
                        "simultaneous_options": {
                            "key_down_order": "strict",
                            "key_up_order": "strict_inverse",
                            "detect_key_down_uninterruptedly": true,
                            "to_after_key_up": [{
                                "set_variable": {
                                    "name": "ergo_fly_keys_spacebar",
                                    "value": 0
                                }
                            }]
                        },
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "to": [{
                            "set_variable": {
                                "name": "ergo_fly_keys_spacebar",
                                "value": 1
                            }
                        },
                        {
                            "set_variable": {
                                "name": "DEBUG simultaneous",
                                "value": 1
                            }
                        },
                        {
                            "key_code": "up_arrow",
                            "modifiers": []
                        }
                    ],
                    "parameters": {
                        "basic.simultaneous_threshold_milliseconds": 300
                    }
                },
