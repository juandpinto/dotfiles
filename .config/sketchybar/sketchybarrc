#!/bin/bash

PLUGIN_DIR="$CONFIG_DIR/plugins"

# ── Theme: auto-switches with macOS appearance ────────────────────────
DARK_MODE=$(defaults read -g AppleInterfaceStyle 2>/dev/null)

if [ "$DARK_MODE" = "Dark" ]; then
  # ── Everforest Dark, medium contrast (active) ─────────────────────────
  # Catppuccin's 14 named accents don't all have an Everforest equivalent
  # (only 7 accents), so PINK and LAVENDER reuse MAUVE's purple, and
  # YELLOW here is actually Everforest's "orange" (kept the var name since
  # the plugin scripts below all reference $YELLOW).
  TEXT=0xffd3c6aa          # fg
  SUBTEXT1=0xff859289      # grey1
  MAUVE=0xffd699b6         # purple
  BLUE=0xff7fbbb3          # blue
  GREEN=0xffa7c080         # green
  RED=0xffe67e80           # red
  YELLOW=0xffe69875        # orange
  TEAL=0xff83c092          # aqua
  PINK=0xffd699b6          # purple
  LAVENDER=0xffd699b6      # purple
  ISLAND_BG=0xcc2d353b     # bg0, frosted
  ISLAND_BORDER=0x40d699b6 # purple border

  # ── VS Code Dark+ — swap in to reactivate ────────────────────────────
  # TEXT=0xffd4d4d4; SUBTEXT1=0xff808080; MAUVE=0xffc586c0
  # BLUE=0xff569cd6; GREEN=0xffb5cea8; RED=0xfff44747; YELLOW=0xffce9178
  # TEAL=0xff4ec9b0; PINK=0xffc586c0; LAVENDER=0xff9cdcfe
  # ISLAND_BG=0x881f1f1f; ISLAND_BORDER=0x40569cd6
else
  # ── Everforest Light, medium contrast (active) ────────────────────────
  TEXT=0xff5c6a72          # fg
  SUBTEXT1=0xff939f91      # grey1
  MAUVE=0xffdf69ba         # purple
  BLUE=0xff3a94c5          # blue
  GREEN=0xff8da101         # green
  RED=0xfff85552           # red
  YELLOW=0xfff57d26        # orange
  TEAL=0xff35a77c          # aqua
  PINK=0xffdf69ba          # purple
  LAVENDER=0xffdf69ba      # purple
  ISLAND_BG=0xccfdf6e3     # bg0, frosted
  ISLAND_BORDER=0x40df69ba # purple border

  # ── VS Code Light+ — swap in to reactivate ───────────────────────────
  # TEXT=0xff343434; SUBTEXT1=0xff767676; MAUVE=0xffaf00db
  # BLUE=0xff007acc; GREEN=0xff098658; RED=0xffa31515; YELLOW=0xff795e26
  # TEAL=0xff267f99; PINK=0xffaf00db; LAVENDER=0xff0000ff
  # ISLAND_BG=0xccffffff; ISLAND_BORDER=0x40007acc
fi

##### Bar Appearance #####
sketchybar --bar \
  position=top \
  height=34 \
  blur_radius=0 \
  color=0x00000000 \
  margin=10 \
  padding_left=0 \
  padding_right=0 \
  topmost=off \
  sticky=on \
  y_offset=4 \
  notch_width=200

##### Defaults #####
sketchybar --default \
  padding_left=4 \
  padding_right=4 \
  icon.font="Hack Nerd Font:Bold:15.0" \
  label.font="SF Pro:Semibold:13.0" \
  icon.color=$TEXT \
  label.color=$TEXT \
  icon.padding_left=5 \
  icon.padding_right=4 \
  label.padding_left=2 \
  label.padding_right=6

##### Aerospace Events #####
sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_monitor_change
sketchybar --add event caffeinate_toggle

##### Apple Logo #####
# sketchybar --add item apple left \
#   --set apple \
#   icon="" \
#   icon.font="Hack Nerd Font:Bold:16.0" \
#   icon.color=$TEXT \
#   label.drawing=off \
#   padding_left=6 \
#   padding_right=4 \
#   click_script="open -a 'System Settings'"
#
##### Aerospace Workspaces #####
for sid in $(aerospace list-workspaces --all); do
  sketchybar --add item space.$sid left \
    --subscribe space.$sid aerospace_workspace_change \
    --set space.$sid \
    display="$(
      v=$(aerospace list-windows --workspace "$sid" --format "%{monitor-appkit-nsscreen-screens-id}" | cut -c1)
      echo "${v:-1}"
    )" \
    drawing=off \
    background.color=0x00000000 \
    background.corner_radius=5 \
    background.drawing=on \
    background.height=26 \
    background.border_width=0 \
    icon="$sid" \
    icon.font="SF Pro:Bold:13.0" \
    icon.color=$LAVENDER \
    icon.padding_left=6 \
    icon.padding_right=4 \
    label.font="sketchybar-app-font:Regular:14.0" \
    label.color=$SUBTEXT1 \
    label.padding_right=12 \
    label.padding_left=0 \
    label.y_offset=-1 \
    click_script="aerospace workspace $sid" \
    script="$CONFIG_DIR/plugins/aerospace.sh $sid"
done

# Load icons on startup
for mid in $(aerospace list-monitors | cut -c1); do
  for sid in $(aerospace list-workspaces --monitor $mid --empty no); do
    apps=$(aerospace list-windows --workspace "$sid" | awk -F'|' '{gsub(/^ *| *$/, "", $2); print $2}')
    sketchybar --set space.$sid drawing=on
    icon_strip=" "
    if [ "${apps}" != "" ]; then
      while read -r app; do
        icon_strip+=" $($CONFIG_DIR/plugins/icon_map_fn.sh "$app")"
      done <<<"${apps}"
    else
      icon_strip=""
    fi
    sketchybar --set space.$sid label="$icon_strip"
  done
done

sketchybar --add item space_separator left \
  --set space_separator \
  icon.drawing=off \
  label.drawing=off \
  background.drawing=off \
  padding_left=0 \
  padding_right=0 \
  script="$PLUGIN_DIR/space_windows.sh" \
  --subscribe space_separator aerospace_workspace_change front_app_switched space_windows_change aerospace_monitor_change

sketchybar --add item front_app left \
  --set front_app \
  icon.drawing=off \
  label.color=$SUBTEXT1 \
  padding_left=2 \
  padding_right=8 \
  script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

##### Left Island Bracket #####
BRACKET_ITEMS=()
for sid in $(aerospace list-workspaces --all); do
  BRACKET_ITEMS+=("space.$sid")
done
BRACKET_ITEMS+=(space_separator front_app)

sketchybar --add bracket left_island "${BRACKET_ITEMS[@]}" \
  --set left_island \
  background.color=$ISLAND_BG \
  background.corner_radius=10 \
  background.height=32 \
  background.border_color=$ISLAND_BORDER \
  background.border_width=1 \
  background.blur_radius=20

##### Right Side Items (clock is rightmost; media is leftmost) #####
sketchybar \
  --add item clock right \
  --set clock \
  icon="" \
  icon.color=$BLUE \
  label.color=$BLUE \
  update_freq=30 \
  padding_right=6 \
  script="$PLUGIN_DIR/clock.sh" \
  \
  --add item battery right \
  --set battery \
  update_freq=120 \
  script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change \
  \
  --add item volume right \
  --set volume \
  icon.color=$PINK \
  label.color=$PINK \
  script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change \
  \
  --add item gpu right \
  --set gpu \
  icon="󰢮" \
  icon.color=$TEAL \
  label.color=$TEAL \
  update_freq=5 \
  script="$PLUGIN_DIR/gpu.sh" \
  \
  --add item cpu right \
  --set cpu \
  icon="" \
  icon.color=$YELLOW \
  label.color=$YELLOW \
  update_freq=5 \
  script="$PLUGIN_DIR/cpu.sh" \
  \
  --add item caffeinate right \
  --set caffeinate \
  icon="󰅶" \
  icon.color=$MAUVE \
  label.drawing=off \
  drawing=off \
  update_freq=5 \
  click_script="sketchybar --trigger caffeinate_toggle" \
  script="$PLUGIN_DIR/caffeinate.sh" \
  --subscribe caffeinate routine caffeinate_toggle \
  \
  --add item vpn right \
  --set vpn \
  icon="󰞀" \
  icon.color=$GREEN \
  label.drawing=off \
  drawing=off \
  update_freq=10 \
  script="$PLUGIN_DIR/vpn.sh" \
  --subscribe vpn system_woke wifi_change \
  \
  --add item wifi right \
  --set wifi \
  update_freq=30 \
  script="$PLUGIN_DIR/wifi.sh" \
  \
  --add item media right \
  --set media \
  icon="♫" \
  icon.font="SF Pro:Bold:12.0" \
  icon.color=$PINK \
  label.color=$SUBTEXT1 \
  label.font="SF Pro:Semibold:12.0" \
  drawing=off \
  padding_left=6 \
  update_freq=5 \
  script="$PLUGIN_DIR/media.sh"

##### Right Island Bracket #####
sketchybar --add bracket right_island media wifi vpn caffeinate cpu gpu volume battery clock \
  --set right_island \
  background.color=$ISLAND_BG \
  background.corner_radius=10 \
  background.height=32 \
  background.border_color=$ISLAND_BORDER \
  background.border_width=1 \
  background.blur_radius=20

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
