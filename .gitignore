.DS_Store
.config/tmux/plugins/*
!.config/tmux/plugins/tpm
.config/pi/agent/auth.json
.config/pi/agent/sessions/
.config/pi/agent/npm/
.config/pi/agent/git/
.config/jiratui/secrets.env
__pycache__/
.ruff_cache/
# Herdr's runtime directory is ~/.config/herdr. Only config.toml and the
# lastfocus and labels plugins are ours; never commit sockets, logs, or session
# state that would land here if Stow folded the directory into the repo.
/.config/herdr/*
!/.config/herdr/config.toml
!/.config/herdr/lastfocus/
!/.config/herdr/labels/
# Copilot CLI's runtime directory is ~/.copilot (settings.json holds trusted
# folders). Only the instructions and skills links and the pi-prompt
# extension are ours, in case Stow ever folds the directory into the repo.
/.copilot/*
!/.copilot/copilot-instructions.md
!/.copilot/skills
!/.copilot/extensions/
/.copilot/extensions/*
!/.copilot/extensions/pi-prompt/
# Mail account configs carry email addresses/logins; they live in the private
# companion repo (~/.dotfiles-private), never here. See platforms/omarchy/mail.md.
platforms/omarchy/home/.config/aerc/accounts.conf
platforms/omarchy/home/.config/isyncrc
platforms/omarchy/home/.config/msmtp/
platforms/omarchy/home/.config/notmuch/
