diff --git i/Workspaces.qml w/Workspaces.qml
index 2d3c46b..9be64dc 100644
--- i/Workspaces.qml
+++ w/Workspaces.qml
@@ -114,6 +114,45 @@ Panel {
     if (root.activeTile === "accent") return Commons.Color.accent
     return Qt.rgba(root.symbolColor.r, root.symbolColor.g, root.symbolColor.b, 0.2)
   }
+  // Rainbow: each numbered workspace takes its own color from the theme's
+  // palette (red, orange, yellow, green, cyan, blue, then magenta) for its
+  // number, tinted icons and the tile when it's focused.
+  readonly property bool rainbow: boolOption("rainbowWorkspaces", false)
+  readonly property var rainbowOrder: ["red", "orange", "yellow", "green", "cyan", "blue", "magenta"]
+  property var themePalette: ({})
+
+  function workspaceColor(key) {
+    var number = Number(key)
+    if (!root.rainbow || !(number > 0)) return root.tintColor
+    var value = root.themePalette[root.rainbowOrder[Math.min(number, root.rainbowOrder.length) - 1]]
+    return value ? value : root.tintColor
+  }
+
+  function loadThemePalette(raw) {
+    var palette = {}
+    var lines = String(raw || "").split("\n")
+    for (var i = 0; i < lines.length; i++) {
+      var match = lines[i].match(/^\s*([A-Za-z0-9_-]+)\s*=\s*["']?(#[0-9A-Fa-f]{6})/)
+      if (match) palette[match[1]] = match[2]
+    }
+    root.themePalette = palette
+  }
+
+  // The shell only keeps a few palette roles; the named colors come from the
+  // theme file, re-read when the shell's own colors change on a theme switch.
+  FileView {
+    id: paletteFile
+    path: Commons.Color.currentThemePath + "/colors.toml"
+    watchChanges: false
+    printErrors: false
+    onLoaded: root.loadThemePalette(text())
+  }
+  Connections {
+    target: Commons.Color
+    function onForegroundChanged() { paletteFile.reload() }
+    function onBackgroundChanged() { paletteFile.reload() }
+    function onAccentChanged() { paletteFile.reload() }
+  }
   readonly property string pillContent: ["icons", "number", "both", "none"].indexOf(String(option("pillContent", "icons"))) !== -1
     ? String(option("pillContent", "icons")) : "icons"
   // The filled or outlined shape around the pill's icons and number.
@@ -804,6 +843,8 @@ Panel {
   // An icon name or, for overrides and desktop entries, an absolute path.
   function themedIcon(name) {
     if (!name) return ""
+    // "mono:" marks a single-color image, drawn in the tint color.
+    if (name.indexOf("mono:") === 0) return "mono:" + themedIcon(name.substring(5))
     if (name.charAt(0) === "/") return "file://" + name
     return Quickshell.iconPath(name, true)
   }
@@ -1025,12 +1066,14 @@ Panel {
   }
 
   function iconFor(info) {
-    var override = root.iconOverrides[info.appId]
-    if (override) return root.themedIcon(String(override))
+    // The program in a terminal wins over an override for the terminal's
