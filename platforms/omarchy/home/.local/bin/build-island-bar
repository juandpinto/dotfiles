#!/usr/bin/env bash
# Derive the island bar from Omarchy's installed bar engine: copy the stock
# plugin's Bar.qml/BarModel.js, apply our recorded island overlay, and write
# the plugin manifest. Rerun after `omarchy update` (post-update hook does).
# `--check` only reports whether the installed plugin matches a fresh build.
set -euo pipefail
stock=/usr/share/omarchy/shell/plugins/bar
repo=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../../../../.." && pwd -P)
patch_file="$repo/platforms/omarchy/patches/island-bar-overlay.patch"
plugin="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/jdpinto.island-bar"
[[ -f $stock/Bar.qml && -f $patch_file ]] || { printf 'missing stock bar or overlay patch\n' >&2; exit 1; }

build=$(mktemp -d "${TMPDIR:-/tmp}/island-bar.XXXXXX")
cp -- "$stock/Bar.qml" "$stock/BarModel.js" "$build/"
patch -s -p1 -d "$build" -i "$patch_file"
jq -n '{
  schemaVersion: 1, id: "jdpinto.island-bar", name: "Island Bar (derived)", version: "0.2.0",
  author: "jdpinto", license: "MIT", kinds: ["bar"], entryPoints: { bar: "Bar.qml" },
  description: "Omarchy'"'"'s installed bar engine as one floating island, configured in shell.toml [island-bar] and regenerated by build-island-bar."
}' > "$build/manifest.json"
cat > "$build/NOTICE" <<'EOF'
Generated by build-island-bar; do not edit here. Bar.qml and BarModel.js are
Omarchy's first-party bar (MIT, copyright David Heinemeier Hansson) from
/usr/share/omarchy/shell/plugins/bar, with our single-island overlay recorded
in platforms/omarchy/patches/island-bar-overlay.patch. Its plugin-bar loading
changes come from mscurtescu/omarchy-island-bar (MIT, copyright 2026 Marius
Scurtescu). Geometry is read from ~/.config/omarchy/shell.toml [island-bar].
EOF

if [[ ${1:-} == --check ]]; then
    for f in Bar.qml BarModel.js manifest.json NOTICE; do
        cmp -s -- "$build/$f" "$plugin/$f" || { printf 'island bar differs from a fresh build: %s (run build-island-bar)\n' "$f" >&2; exit 1; }
    done
    printf 'island bar matches the installed engine plus overlay\n'
    exit 0
fi
mkdir -p "$plugin"
for f in Bar.qml BarModel.js manifest.json NOTICE; do
    cmp -s -- "$build/$f" "$plugin/$f" 2>/dev/null || cp -- "$build/$f" "$plugin/$f"
done
printf 'island bar built in %s\n' "$plugin"
