#!/usr/bin/env bash
# Open/focus the upstream widget's selected session using the configured terminal.
# The upstream widget still owns discovery, presentation, pinning and confirmations.
set -euo pipefail
session=${1:?Expected a session JSON object}
pane=${2:-}
name=$(jq -er '.name | strings' <<< "$session")
machine=$(jq -r '.machineId // ""' <<< "$session")
address=$(jq -r '.windowAddress // ""' <<< "$session")
[[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || exit 2
[[ -z $pane || $pane =~ ^[A-Za-z0-9_-]{1,32}:[A-Za-z0-9_-]{1,32}$ ]] || exit 2
# Preserve the upstream screenshot/demo mode's guarantee of no side effects.
[[ ! -f ${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-herdr/demo ]] || exit 0

remote=()
attach=()
if [[ -n $machine ]]; then
    [[ $machine =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || exit 2
    target=$(herdr machine list --json | jq -er --arg id "$machine" \
        '.[] | select(.id == $id and .enabled == true) | .target')
    [[ $target =~ ^(ssh://)?([A-Za-z0-9._-]+@)?[A-Za-z0-9._-]+(:[0-9]{1,5})?$ ]] || exit 2
    remote=(--machine "$machine")
    attach=(--remote "$target")
elif [[ $name != default ]]; then
    remote=(--session "$name")
fi
[[ $name == default ]] || attach+=(--session "$name")

if [[ -n $pane ]]; then
    herdr "${remote[@]}" agent focus "$pane" >/dev/null
fi

# A still-open window wins over launching a second view of the same session.
if [[ $address =~ ^0x[0-9a-fA-F]+$ ]]; then
    workspace=$(hyprctl clients -j | jq -r --arg address "$address" \
        '.[] | select(.address == $address) | .workspace.name')
    if [[ $workspace =~ ^(special:)?[A-Za-z0-9_-]{1,32}$ ]]; then
        hyprctl dispatch "hl.dsp.focus({ workspace = '$workspace' })" >/dev/null
        hyprctl dispatch "hl.dsp.focus({ window = 'address:$address' })" >/dev/null
        exit 0
    fi
fi
if [[ -z $machine && $name =~ ^[0-9]{1,3}$ ]]; then
    hyprctl dispatch "hl.dsp.focus({ workspace = '$name' })" >/dev/null
fi

launch=(xdg-terminal-exec --app-id=org.omarchy.herdr --dir="$HOME" -- herdr "${attach[@]}")
if command -v uwsm-app >/dev/null 2>&1; then
    exec setsid uwsm-app -- "${launch[@]}"
else
    exec setsid "${launch[@]}"
fi
