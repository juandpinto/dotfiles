;; Linux wrapper for the separate Caps + SpaceFN foreground trial.
;; This does not replace the saved, working Caps-only configuration.
(defcfg
  process-unmapped-keys yes
  linux-dev-names-include ("Apple SPI Keyboard")
  linux-output-device-name "kanata-spacefn-trial"
)

(include keymap-spacefn.kbd)
