# Generated palette; Starship retains its default, informative module layout.
[directory]
style = "bold {{ cyan }}"
[git_branch]
style = "bold {{ magenta }}"
[git_commit]
style = "bold {{ green }}"
[git_state]
style = "bold {{ yellow }}"
[git_status]
style = "bold {{ red }}"
[package]
style = "bold {{ orange }}"
[python]
style = "bold {{ yellow }}"
[nodejs]
style = "bold {{ green }}"
[rust]
style = "bold {{ red }}"
[golang]
style = "bold {{ cyan }}"
[java]
style = "dimmed {{ red }}"
[docker_context]
style = "bold {{ blue }}"
[conda]
style = "bold {{ green }}"
[aws]
style = "bold {{ yellow }}"
[gcloud]
style = "bold {{ blue }}"
[cmd_duration]
style = "bold {{ yellow }}"
[jobs]
style = "bold {{ blue }}"
[time]
disabled = true
[character]
success_symbol = "[❯](bold {{ green }})"
error_symbol = "[❯](bold {{ red }})"
vimcmd_symbol = "[❮](bold {{ green }})"
vimcmd_replace_one_symbol = "[❮](bold {{ magenta }})"
vimcmd_replace_symbol = "[❮](bold {{ magenta }})"
vimcmd_visual_symbol = "[❮](bold {{ yellow }})"
